# Copy to .env and adjust as needed.

# HTTP server
HOST=0.0.0.0
PORT=4000

# CORS origin allowed to call this API (the central-ui dev server)
CORS_ORIGIN=http://localhost:5173

# How often (in seconds) the backend polls each endpoint agent for status.
# Not yet implemented — placeholder for the polling architecture.
AGENT_POLL_INTERVAL_SECONDS=60

# Path to the CSV file containing the agent inventory.
# Columns: display_name,fqdn,port,os_flavor
AGENT_INVENTORY_FILE=./inventory.example.csv

# Logging level: debug | info | warn | error
LOG_LEVEL=info
