# Copy to .env and adjust as needed.

# HTTP server
HOST=0.0.0.0
PORT=4000

# CORS origin allowed to call this API (the central-ui dev server)
CORS_ORIGIN=http://localhost:5173

# How often (in seconds) the backend polls each endpoint agent for status.
AGENT_POLL_INTERVAL_SECONDS=60

# HTTP timeout (ms) for lightweight agent calls: /status, /memory, approvals.
# AGENT_POLL_TIMEOUT_MS=3000

# HTTP timeout (ms) for message/send calls that run the full agent tool-use loop.
# AGENT_MESSAGE_TIMEOUT_MS=60000

# Path to the CSV file containing the agent inventory.
# Columns: display_name,fqdn,port,os_flavor
AGENT_INVENTORY_FILE=./inventory.example.csv

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Bearer token sent to every endpoint-server agent. Required — must match
# each agent's security.token (security.scheme: bearer in config.yaml).
AGENT_AUTH_TOKEN=

# Fleet intelligence: periodic AI analysis of the whole fleet.
# Uses any OpenAI-compatible API. Set INTELLIGENCE_BASE_URL to enable.
# Examples:
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
#   Together:  https://api.together.xyz/v1
INTELLIGENCE_BASE_URL=
# API key (use "none" or any dummy value for unauthenticated local servers)
INTELLIGENCE_API_KEY=none
# Model name as the target API expects it
INTELLIGENCE_MODEL=gpt-4o
# How often to re-analyse (minutes). 0 = only once on startup.
# INTELLIGENCE_INTERVAL_MINUTES=30
# Timeout (ms) for calls to the intelligence endpoint — covers fleet chat,
# the daily briefing, and periodic intelligence analysis. Without this, a
# slow/unresponsive local model can hang a request until an upstream proxy
# kills it (e.g. the dashboard chat returning a bare 504) instead of
# central-backend failing fast with a clear message.
# INTELLIGENCE_TIMEOUT_MS=1200000
# Directory for persistent intelligence storage (PVC mount in production).
# When set, the latest report survives restarts and prior analyses are fed
# back into each LLM prompt for trend detection. Leave empty to disable.
# INTELLIGENCE_DATA_DIR=/data
# How many prior reports to inject as historical context. Default: 5.
# INTELLIGENCE_HISTORY_SIZE=5

# Directory for persistent per-user chat history (PVC mount in production).
# Chats survive restarts and are restored to the UI on login. Defaults to
# ./data/chats; set empty to keep chat history in memory only.
# CHAT_DATA_DIR=data/chats
# Maximum messages retained per chat thread per user. Default: 200.
# CHAT_MAX_MESSAGES=200

# OpenTelemetry trace export — same OTEL_* env var names used by
# endpoint-server and central-ui. Unset (the default) disables tracing
# entirely; an unreachable collector never fails requests.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=central-backend
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=
