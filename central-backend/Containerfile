FROM registry.access.redhat.com/ubi9/nodejs-24-minimal:9.8-1781562052

WORKDIR /app

COPY package*.json ./

RUN npm ci --only=production

COPY src/ ./src/

ENV HOST=0.0.0.0 \
    PORT=8080 \
    CORS_ORIGIN=http://localhost:5173 \
    AGENT_POLL_INTERVAL_SECONDS=60 \
    AGENT_INVENTORY_FILE=./inventory.csv \
    LOG_LEVEL=info \
    AGENT_AUTH_TOKEN= \
    OTEL_EXPORTER_OTLP_ENDPOINT=

EXPOSE 8080

CMD ["npm", "start"]
