FROM registry.access.redhat.com/ubi9/nodejs-24-minimal:9.8-1781562052 AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build

FROM registry.access.redhat.com/ubi9/nginx-126:9.8-1781730833

USER root

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf.template
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY entrypoint.sh /entrypoint.sh

RUN find /usr/share/nginx/html -type d -exec chmod 755 {} + && \
    find /usr/share/nginx/html -type f -exec chmod 644 {} + && \
    chmod 444 /etc/nginx/conf.d/default.conf.template && \
    chmod 666 /etc/nginx/conf.d/default.conf && \
    chmod 755 /entrypoint.sh

USER 1001

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
