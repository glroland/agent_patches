FROM registry.access.redhat.com/ubi9/nodejs-24-minimal:9.8-1781562052 AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build

FROM registry.access.redhat.com/ubi9/nginx-126:9.8-1781730833

COPY --from=builder /app/dist /usr/share/nginx/html

COPY --chmod=444 nginx.conf /etc/nginx/conf.d/default.conf.template
COPY --chmod=666 nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 entrypoint.sh /entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
