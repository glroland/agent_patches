FROM node:20-alpine AS builder

WORKDIR /app

COPY central-ui/package*.json ./central-ui/

RUN cd central-ui && npm ci

COPY central-ui/ ./central-ui/
COPY .env .env

RUN cd central-ui && npm run build

ENV VITE_API_BASE_URL=http://localhost:4000/api

FROM nginx:alpine

COPY --from=builder /app/central-ui/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
