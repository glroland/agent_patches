worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /run/nginx.pid;

# Load dynamic modules. See /usr/share/doc/nginx/README.dynamic.
include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile            on;
    tcp_nopush          on;
    keepalive_timeout   65;
    types_hash_max_size 4096;

    include             /etc/nginx/mime.types;
    default_type        application/octet-stream;

    # Load modular configuration files from the /etc/nginx/conf.d directory.
    # See http://nginx.org/en/docs/ngx_core_module.html#include
    # for more information.
    #include /opt/app-root/etc/nginx.d/*.conf;

    server {
        listen       127.0.0.1:8080 default_server;
        server_name  _;
        #root         /opt/app-root/src;

        # Load configuration files for the default server block.
        #include /opt/app-root/etc/nginx.default.d/*.conf;

        root /usr/share/nginx/html;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        location /api {

            proxy_pass ${BACKEND_URL}/api;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /ws {

            proxy_pass ${BACKEND_URL}/ws;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $proxy_host;
            proxy_read_timeout 3600s;
        }

        # Same-origin proxy for browser-side OpenTelemetry trace export
        # (src/tracing.js), so the bundle never needs to know the collector's
        # address and never hits CORS. OTEL_EXPORTER_OTLP_ENDPOINT is the
        # same env var used by central-backend/endpoint-server; when unset,
        # entrypoint.sh defaults it to a loopback placeholder so nginx still
        # starts — requests here just get connection-refused, which the
        # exporter already treats as a non-fatal export failure.
        location /v1/traces {

            proxy_pass ${OTEL_EXPORTER_OTLP_ENDPOINT}/v1/traces;
            proxy_set_header Host $proxy_host;
        }

    }

}

