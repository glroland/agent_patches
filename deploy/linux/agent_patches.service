[Unit]
Description=agent_patches – AI-powered server administration agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent_patches
Group=agent_patches

# Working directory is where tasks.jsonl is written (storage.tasks_file default)
WorkingDirectory=/opt/agent_patches
ExecStart=/opt/agent_patches/bin/patches-endpoint-server
Environment=AGENT_PATCHES_CONFIG=/opt/agent_patches/config/config.yaml

Restart=on-failure
RestartSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent_patches

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Allow writes to the working directory (tasks.jsonl); config is root-owned
# so the service user can read but not modify it even though the path is listed.
ReadWritePaths=/opt/agent_patches

[Install]
WantedBy=multi-user.target
