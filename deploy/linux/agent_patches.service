[Unit]
Description=agent_patches – AI-powered server administration agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Working directory is where tasks.jsonl is written (storage.tasks_file default)
WorkingDirectory=/opt/agent_patches
ExecStart=/opt/agent_patches/bin/patches-endpoint-server
Environment=AGENT_PATCHES_CONFIG=/opt/agent_patches/config/config.yaml

# Optional OpenTelemetry trace export — same OTEL_* env var names used by
# central-backend/central-ui. Unset (the default) keeps tracing disabled.
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://eclipse.home.glroland.com:4317

Restart=on-failure
RestartSec=10s
TimeoutStopSec=35

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent_patches

PrivateTmp=true

[Install]
WantedBy=multi-user.target
